# Copy to infra/.env and `chmod 600 infra/.env`. Never commit the real file.

# Domain — single source of truth (Caddy, ntfy base URL).
# localhost = Caddy internal CA (local dev). Production: <name>.duckdns.org,
# which also serves ntfy.<name>.duckdns.org. Both need public DNS + ports 80/443.
APP_DOMAIN=localhost

# Optional Let's Encrypt account email. Empty = register without one.
ACME_EMAIL=

# Strict-Transport-Security (max-age=1y). Set to `on` only once APP_DOMAIN is
# final (Security doc §6); browsers cache it for a year. Values: on | off.
HSTS=off

# Host ports Caddy publishes. Keep 80/443 in production.
HTTP_PORT=80
HTTPS_PORT=443

# Postgres. Generate with: openssl rand -hex 32  (hex keeps DATABASE_URL valid)
POSTGRES_PASSWORD=

DEFAULT_TZ=Asia/Kolkata

# Google OAuth client (same Cloud project as Calendar OAuth, runbook B7).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email via Gmail API (HE-030, runbook B7). Dedicated sender account, scope gmail.send.
GMAIL_SENDER=
# Secret. Get it once with: docker compose exec api python -m scripts.gmail_authorize
GMAIL_OAUTH_REFRESH_TOKEN=
