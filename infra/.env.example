# Copy to infra/.env and `chmod 600 infra/.env`. Never commit the real file.

# Domain — single source of truth (used by Caddy from HE-003).
APP_DOMAIN=localhost

# Host ports Caddy publishes. Keep 80/443 in production.
HTTP_PORT=80
HTTPS_PORT=443

# Postgres. Generate with: openssl rand -hex 32  (hex keeps DATABASE_URL valid)
POSTGRES_PASSWORD=

DEFAULT_TZ=Asia/Kolkata
